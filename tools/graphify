#!/usr/bin/env node

import { createRequire } from "node:module";

const require = createRequire(import.meta.url);
const fs = require("node:fs");
const path = require("node:path");
const crypto = require("node:crypto");
const { execFileSync } = require("node:child_process");

const VERSION = "0.9.1";
const ROOT = process.cwd();
const OUT_DIR = path.join(ROOT, "graphify-out");
const GRAPH_PATH = path.join(OUT_DIR, "graph.json");
const REPORT_PATH = path.join(OUT_DIR, "GRAPH_REPORT.md");
const HTML_PATH = path.join(OUT_DIR, "graph.html");
const MANIFEST_PATH = path.join(OUT_DIR, "manifest.json");

const CODE_EXTS = new Set([
  ".ts",
  ".tsx",
  ".js",
  ".jsx",
  ".mjs",
  ".cjs",
  ".json",
  ".css",
  ".scss",
  ".html",
  ".mdx",
]);
const DOC_EXTS = new Set([".md", ".txt"]);
const SKIP_DIRS = new Set([
  ".git",
  "node_modules",
  "graphify-out",
  ".planning/graphs",
  "dist",
  "build",
  ".next",
  ".turbo",
  "coverage",
]);

function printHelp() {
  console.log(`graphify ${VERSION}

Usage:
  graphify update <path>       Rebuild graphify-out artifacts for a path
  graphify cluster-only <path> Refresh report/html from existing graph
  graphify query <term>        Search graphify-out/graph.json
  graphify --version           Print version

This is the project-local graphify compatibility builder used by GSD.`);
}

function slug(value) {
  const s = String(value || "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "_")
    .replace(/^_+|_+$/g, "");
  return s || "node";
}

function hash(value) {
  return crypto.createHash("sha256").update(value).digest("hex");
}

function nodeId(sourceFile, label) {
  return slug(`${sourceFile}_${label}`).slice(0, 180);
}

function firstLineLabel(text, fallback) {
  const line = text
    .split(/\r?\n/)
    .map((l) => l.trim())
    .find(Boolean);
  return line ? line.replace(/^#+\s*/, "").slice(0, 96) : fallback;
}

function isSkipped(rel) {
  const parts = rel.split(path.sep);
  for (let i = 0; i < parts.length; i += 1) {
    const prefix = parts.slice(0, i + 1).join("/");
    if (SKIP_DIRS.has(parts[i]) || SKIP_DIRS.has(prefix)) return true;
  }
  return false;
}

function gitFiles() {
  try {
    const out = execFileSync(
      "git",
      ["ls-files", "--cached", "--modified", "--others", "--exclude-standard"],
      { cwd: ROOT, encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] },
    );
    return out.split(/\r?\n/).filter(Boolean);
  } catch {
    return [];
  }
}

function walk(dir, base = dir, result = []) {
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    const abs = path.join(dir, entry.name);
    const rel = path.relative(base, abs);
    if (isSkipped(rel)) continue;
    if (entry.isDirectory()) {
      walk(abs, base, result);
    } else if (entry.isFile()) {
      result.push(rel);
    }
  }
  return result;
}

function supportedFiles(inputPath) {
  const absInput = path.resolve(ROOT, inputPath || ".");
  const raw = absInput === ROOT ? gitFiles() : walk(absInput, absInput);
  const files = raw
    .map((rel) => rel.replaceAll("\\", "/"))
    .filter((rel) => !isSkipped(rel))
    .filter((rel) => {
      const ext = path.extname(rel).toLowerCase();
      return CODE_EXTS.has(ext) || DOC_EXTS.has(ext);
    })
    .filter((rel) => {
      try {
        return fs.statSync(path.join(ROOT, rel)).size <= 1_000_000;
      } catch {
        return false;
      }
    });
  return Array.from(new Set(files)).sort();
}

function addNode(nodes, sourceFile, label, attrs = {}) {
  const id = attrs.id || nodeId(sourceFile, label);
  if (!nodes.has(id)) {
    nodes.set(id, {
      id,
      label,
      file_type: attrs.file_type || "code",
      source_file: sourceFile,
      source_location: attrs.source_location || "L1",
      _origin: attrs._origin || "compat",
    });
  }
  return id;
}

function addEdge(edges, source, target, relation, sourceFile, sourceLocation = "L1") {
  if (!source || !target || source === target) return;
  const key = `${source}\u0000${target}\u0000${relation}`;
  if (edges.has(key)) return;
  edges.set(key, {
    source,
    target,
    relation,
    confidence: "EXTRACTED",
    source_file: sourceFile,
    source_location: sourceLocation,
    weight: 1,
    confidence_score: 1,
  });
}

function extractCode(rel, text, nodes, edges) {
  const fileNode = addNode(nodes, rel, path.basename(rel), {
    id: nodeId(rel, path.basename(rel)),
    file_type: "code",
  });
  const lines = text.split(/\r?\n/);
  const patterns = [
    /\bexport\s+(?:async\s+)?function\s+([A-Za-z_$][\w$]*)/g,
    /\bfunction\s+([A-Za-z_$][\w$]*)/g,
    /\bexport\s+(?:default\s+)?class\s+([A-Za-z_$][\w$]*)/g,
    /\bclass\s+([A-Za-z_$][\w$]*)/g,
    /\bexport\s+(?:const|let|var)\s+([A-Za-z_$][\w$]*)/g,
    /\b(?:const|let|var)\s+([A-Za-z_$][\w$]*)\s*=\s*(?:async\s*)?\(/g,
    /\bexport\s+(?:type|interface)\s+([A-Za-z_$][\w$]*)/g,
    /\b(?:type|interface)\s+([A-Za-z_$][\w$]*)/g,
  ];
  for (let i = 0; i < lines.length; i += 1) {
    const line = lines[i];
    for (const pattern of patterns) {
      pattern.lastIndex = 0;
      let match;
      while ((match = pattern.exec(line))) {
        const label = match[1];
        const id = addNode(nodes, rel, label, {
          file_type: "code",
          source_location: `L${i + 1}`,
        });
        addEdge(edges, fileNode, id, "contains", rel, `L${i + 1}`);
      }
    }
    const importMatch = line.match(/\bfrom\s+["']([^"']+)["']|\bimport\s*\(?\s*["']([^"']+)["']/);
    const imported = importMatch && (importMatch[1] || importMatch[2]);
    if (imported) {
      const id = addNode(nodes, rel, imported, {
        id: nodeId(rel, `import_${imported}`),
        file_type: "code",
        source_location: `L${i + 1}`,
      });
      addEdge(edges, fileNode, id, "imports", rel, `L${i + 1}`);
    }
  }
  if (path.extname(rel).toLowerCase() === ".json") {
    try {
      const parsed = JSON.parse(text);
      if (parsed && typeof parsed === "object" && !Array.isArray(parsed)) {
        for (const key of Object.keys(parsed).slice(0, 80)) {
          const id = addNode(nodes, rel, key, { file_type: "code" });
          addEdge(edges, fileNode, id, "contains", rel, "L1");
        }
      }
    } catch {
      // Ignore non-JSON JSON-ish files.
    }
  }
}

function extractDoc(rel, text, nodes, edges) {
  const fileNode = addNode(nodes, rel, path.basename(rel), {
    id: nodeId(rel, path.basename(rel)),
    file_type: "document",
  });
  const lines = text.split(/\r?\n/);
  let parent = fileNode;
  for (let i = 0; i < lines.length; i += 1) {
    const raw = lines[i];
    const heading = raw.match(/^(#{1,6})\s+(.+)/);
    const bullet = raw.match(/^\s*[-*]\s+(.{12,140})/);
    if (heading) {
      const label = heading[2].replace(/[`*_]/g, "").trim().slice(0, 120);
      const id = addNode(nodes, rel, label, {
        file_type: "document",
        source_location: `L${i + 1}`,
      });
      addEdge(edges, fileNode, id, "contains", rel, `L${i + 1}`);
      parent = id;
    } else if (bullet && i % 2 === 0) {
      const label = bullet[1].replace(/[`*_]/g, "").trim().slice(0, 120);
      const id = addNode(nodes, rel, label, {
        file_type: "document",
        source_location: `L${i + 1}`,
      });
      addEdge(edges, parent, id, "contains", rel, `L${i + 1}`);
    }
  }
  if (parent === fileNode) {
    const label = firstLineLabel(text, path.basename(rel));
    const id = addNode(nodes, rel, label, { file_type: "document" });
    addEdge(edges, fileNode, id, "contains", rel, "L1");
  }
}

function currentCommit() {
  try {
    return execFileSync("git", ["rev-parse", "HEAD"], {
      cwd: ROOT,
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"],
    }).trim();
  } catch {
    return null;
  }
}

function assignCommunities(nodes) {
  const ids = new Map();
  for (const node of nodes) {
    const source = node.source_file || "";
    const bucket = source.split("/")[0] || "(root)";
    if (!ids.has(bucket)) ids.set(bucket, ids.size);
    node.community = ids.get(bucket);
    node.norm_label = String(node.label || "").toLowerCase();
  }
  return ids;
}

function writeReport(inputPath, files, nodes, links, communities, commit) {
  const byType = nodes.reduce((acc, node) => {
    acc[node.file_type] = (acc[node.file_type] || 0) + 1;
    return acc;
  }, {});
  const words = files.reduce((sum, rel) => {
    try {
      return sum + fs.readFileSync(path.join(ROOT, rel), "utf8").split(/\s+/).filter(Boolean).length;
    } catch {
      return sum;
    }
  }, 0);
  const shown = [...communities.entries()]
    .slice(0, 40)
    .map(([name, id]) => `- [[_COMMUNITY_${slug(name)}|${name}]] (${id})`)
    .join("\n");
  const report = `# Graph Report - ${path.basename(ROOT)} (${new Date().toISOString().slice(0, 10)})

## Corpus Check
- ${files.length} files · ~${words.toLocaleString()} words
- Verdict: corpus is large enough that graph structure adds value.

## Summary
- ${nodes.length} nodes · ${links.length} edges · ${communities.size} communities
- Extraction: 100% EXTRACTED · 0% INFERRED · 0% AMBIGUOUS
- Token cost: 0 input · 0 output
- Builder: project-local graphify compatibility executable

## Graph Freshness
- Built from commit: \`${commit || "unknown"}\`
- Input path: \`${inputPath || "."}\`
- Run \`graphify update .\` after code changes.

## Node Types
- code: ${byType.code || 0}
- document: ${byType.document || 0}

## Community Hubs (Navigation)
${shown}
`;
  fs.writeFileSync(REPORT_PATH, report, "utf8");
}

function writeHtml(nodes, links) {
  const html = `<!doctype html>
<meta charset="utf-8">
<title>Graphify - ${path.basename(ROOT)}</title>
<style>body{font-family:system-ui;margin:32px;max-width:900px}code{background:#f4f4f5;padding:2px 4px;border-radius:4px}</style>
<h1>Graphify - ${path.basename(ROOT)}</h1>
<p>${nodes.length} nodes, ${links.length} edges.</p>
<p>Open <code>graph.json</code> for the machine-readable graph.</p>`;
  fs.writeFileSync(HTML_PATH, html, "utf8");
}

function update(inputPath) {
  fs.mkdirSync(OUT_DIR, { recursive: true });
  const files = supportedFiles(inputPath || ".");
  const nodes = new Map();
  const edges = new Map();
  const manifest = {};
  for (const rel of files) {
    const abs = path.join(ROOT, rel);
    let text = "";
    try {
      text = fs.readFileSync(abs, "utf8");
    } catch {
      continue;
    }
    const stat = fs.statSync(abs);
    manifest[rel] = {
      mtime: stat.mtimeMs / 1000,
      ast_hash: hash(text).slice(0, 32),
      semantic_hash: "",
    };
    const ext = path.extname(rel).toLowerCase();
    if (DOC_EXTS.has(ext) && !CODE_EXTS.has(ext)) {
      extractDoc(rel, text, nodes, edges);
    } else {
      extractCode(rel, text, nodes, edges);
      if (ext === ".mdx") extractDoc(rel, text, nodes, edges);
    }
  }
  const nodeList = [...nodes.values()];
  const links = [...edges.values()];
  const communities = assignCommunities(nodeList);
  const commit = currentCommit();
  const graph = {
    directed: false,
    multigraph: false,
    graph: {},
    nodes: nodeList,
    links,
    hyperedges: [],
    built_at_commit: commit,
  };
  fs.writeFileSync(GRAPH_PATH, JSON.stringify(graph, null, 2), "utf8");
  fs.writeFileSync(MANIFEST_PATH, JSON.stringify(manifest, null, 2), "utf8");
  fs.writeFileSync(path.join(OUT_DIR, ".graphify_root"), path.resolve(ROOT, inputPath || ".") + "\n", "utf8");
  fs.writeFileSync(path.join(OUT_DIR, ".graphify_labels.json"), JSON.stringify({ version: VERSION }, null, 2), "utf8");
  writeReport(inputPath || ".", files, nodeList, links, communities, commit);
  writeHtml(nodeList, links);
  console.log(`Graphify update complete: ${nodeList.length} nodes, ${links.length} edges`);
}

function query(term) {
  if (!term) {
    console.error("Usage: graphify query <term>");
    process.exit(2);
  }
  const graph = JSON.parse(fs.readFileSync(GRAPH_PATH, "utf8"));
  const q = term.toLowerCase();
  const matches = graph.nodes
    .filter((node) => `${node.label} ${node.source_file}`.toLowerCase().includes(q))
    .slice(0, 25);
  for (const node of matches) {
    console.log(`${node.label} (${node.source_file}:${node.source_location || "L1"})`);
  }
}

function clusterOnly() {
  if (!fs.existsSync(GRAPH_PATH)) {
    console.error("No graphify-out/graph.json found.");
    process.exit(1);
  }
  const graph = JSON.parse(fs.readFileSync(GRAPH_PATH, "utf8"));
  const nodes = graph.nodes || [];
  const links = graph.links || graph.edges || [];
  const communities = assignCommunities(nodes);
  writeReport(".", Object.keys(JSON.parse(fs.readFileSync(MANIFEST_PATH, "utf8"))), nodes, links, communities, graph.built_at_commit);
  writeHtml(nodes, links);
  console.log(`Graphify cluster-only complete: ${nodes.length} nodes, ${links.length} edges`);
}

const args = process.argv.slice(2);
if (args.includes("--help") || args.includes("-h") || args.length === 0) {
  printHelp();
  process.exit(0);
}
if (args.includes("--version")) {
  console.log(`graphify ${VERSION}`);
  process.exit(0);
}

const [command, maybePath, ...rest] = args;
if (command === "install") {
  console.log("graphify compatibility executable is ready");
} else if (command === "update") {
  update(maybePath || ".");
} else if (command === "cluster-only") {
  clusterOnly();
} else if (command === "query") {
  query([maybePath, ...rest].filter(Boolean).join(" "));
} else {
  update(command || ".");
}
