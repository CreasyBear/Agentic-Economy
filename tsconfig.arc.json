{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": ".cache/arc-types",
    "tsBuildInfoFile": ".cache/arc.tsbuildinfo",
    "rootDir": ".",
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "src/components/arc/**/*.ts",
    "src/components/arc/**/*.tsx",
    "src/components/ae/shared/base-ui/**/*.tsx",
    "src/lib/arc/**/*.tsx",
    "src/lib/utils.ts"
  ],
  "exclude": []
}
