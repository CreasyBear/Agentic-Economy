{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable",
      "ES2024"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "ignoreDeprecations": "5.0",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "paths": {
      "@/routes/owner.*": [
        "./src/routes/_operator/owner.*"
      ],
      "@/routes/admin.*": [
        "./src/routes/_operator/admin.*"
      ],
      "@/routes/developers.discovery": [
        "./src/routes/_operator/developers.discovery"
      ],
      "next/image": [
        "./src/lib/arc/next-image.tsx"
      ],
      "@/*": [
        "./src/*"
      ],
      "~/*": [
        "./src/*"
      ]
    },
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "convex/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "scripts/build-cli.ts",
    "scripts/test-cli-package.ts",
    "tools/dev/deps-ratchet.ts",
    "tools/dev/guard-destructive-git.ts",
    "tools/dev/local-connect.ts",
    "tools/dev/local-dev.ts",
    "tools/dev/local-source-write-secret.ts",
    "tools/dev/require-supported-node.ts",
    "tools/dev/run-listed-vitest.ts",
    "tools/dev/run-with-cleanup.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "convex/_generated",
    "src/components/arc/accordion/**/*",
    "src/components/arc/alert/**/*",
    "src/components/arc/animated-counter/**/*",
    "src/components/arc/avatar/**/*",
    "src/components/arc/avatar-group/**/*",
    "src/components/arc/badge/**/*",
    "src/components/arc/button/**/*",
    "src/components/arc/chip-group/**/*",
    "src/components/arc/combobox/**/*",
    "src/components/arc/copy-button/**/*",
    "src/components/arc/donut-chart/**/*",
    "src/components/arc/empty-state/**/*",
    "src/components/arc/empty-states/**/*",
    "src/components/arc/expandable-card/**/*",
    "src/components/arc/filter-toolbar/**/*",
    "src/components/arc/input/**/*",
    "src/components/arc/lib/**/*",
    "src/components/arc/line-chart/**/*",
    "src/components/arc/progress/**/*",
    "src/components/arc/radio-cards/**/*",
    "src/components/arc/search-field/**/*",
    "src/components/arc/segmented-control/**/*",
    "src/components/arc/skeleton/**/*",
    "src/components/arc/sortable-data-table/**/*",
    "src/components/arc/sparkline/**/*",
    "src/components/arc/stepper/**/*",
    "src/components/arc/textarea/**/*",
    "src/components/arc/usage-meter/**/*",
    "src/components/arc/blocks/comparison-table/**/*",
    "src/components/arc/blocks/faq-section/**/*",
    "src/components/arc/blocks/hero-section/**/*",
    "src/components/arc/blocks/site-footer/**/*",
    "src/components/arc/motion-tokens.ts",
    "src/lib/arc/**/*"
  ],
  "references": [
    {
      "path": "./tsconfig.arc.json"
    }
  ]
}
