# Clerk TanStack Start keys. See https://clerk.com/docs/tanstack-react-start/getting-started/quickstart
VITE_CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=

# Convex + Clerk issuer. See https://docs.convex.dev/auth/clerk
VITE_CONVEX_URL=
# Source-write:v2 trust envelope. Production must configure each scoped family as
# `safeKeyId:at-least-32-byte-secret`; non-production may derive family keys from
# an independent AE_SOURCE_WRITE_SECRET with HKDF (all material is server-only).
AE_SOURCE_WRITE_SECRET=
AE_SOURCE_WRITE_KEY_INQUIRY=
AE_SOURCE_WRITE_PREVIOUS_KEYS_INQUIRY=
AE_SOURCE_WRITE_KEY_BILLING=
AE_SOURCE_WRITE_PREVIOUS_KEYS_BILLING=
AE_SOURCE_WRITE_KEY_PROTECTED=
AE_SOURCE_WRITE_PREVIOUS_KEYS_PROTECTED=
AE_SOURCE_WRITE_KEY_CLAIM=
AE_SOURCE_WRITE_PREVIOUS_KEYS_CLAIM=
AE_SOURCE_WRITE_KEY_OPERATOR=
AE_SOURCE_WRITE_PREVIOUS_KEYS_OPERATOR=
AE_SOURCE_WRITE_KEY_REPAIR=
AE_SOURCE_WRITE_PREVIOUS_KEYS_REPAIR=
AE_SOURCE_WRITE_KEY_SESSION=
AE_SOURCE_WRITE_PREVIOUS_KEYS_SESSION=
AE_SOURCE_WRITE_DERIVED_KEY_ID_INQUIRY=
AE_SOURCE_WRITE_PREVIOUS_DERIVED_KEY_IDS_INQUIRY=
AE_SOURCE_WRITE_DERIVED_KEY_ID_BILLING=
AE_SOURCE_WRITE_PREVIOUS_DERIVED_KEY_IDS_BILLING=
AE_SOURCE_WRITE_DERIVED_KEY_ID_PROTECTED=
AE_SOURCE_WRITE_PREVIOUS_DERIVED_KEY_IDS_PROTECTED=
AE_SOURCE_WRITE_DERIVED_KEY_ID_CLAIM=
AE_SOURCE_WRITE_PREVIOUS_DERIVED_KEY_IDS_CLAIM=
AE_SOURCE_WRITE_DERIVED_KEY_ID_OPERATOR=
AE_SOURCE_WRITE_PREVIOUS_DERIVED_KEY_IDS_OPERATOR=
AE_SOURCE_WRITE_DERIVED_KEY_ID_REPAIR=
AE_SOURCE_WRITE_PREVIOUS_DERIVED_KEY_IDS_REPAIR=
AE_SOURCE_WRITE_DERIVED_KEY_ID_SESSION=
AE_SOURCE_WRITE_PREVIOUS_DERIVED_KEY_IDS_SESSION=
CLERK_JWT_ISSUER_DOMAIN=

# Server-only service and route authorities (opaque values; never expose to Vite).
AE_CONVEX_SERVER_FUNCTION_TOKEN=
AE_ROUTE_CALL_SIGNING_SECRET=
AE_ROUTE_CALL_SIGNING_KEY_ID=
# x402 payer custody is independent of provider connections. Keep only the
# opaque locator in configuration; the referenced private key remains server-only.
AE_X402_PAYMENT_CREDENTIAL_REF=
AE_X402_PAYMENT_PRIVATE_KEY=
# JSON map from admitted EVM network to a server-only HTTPS JSON-RPC endpoint.
# Example shape: {"eip155:8453":"https://base-mainnet.example/rpc"}
AE_X402_RPC_URLS_JSON=

# Optional server URLs used by model/discovery and seeded sandbox projections.
SITE_URL=
AE_SITE_URL=
AE_OPENROUTER_API_BASE_URL=


# External agent/CLI client. AE_API_KEY is a reusable caller credential delivered once; it is never a supplier credential.
AE_CLI_BASE_URL=
AE_API_KEY=

# Destructive, opt-in paid production Operation smoke. The configured owner publication,
# completed live Stripe Checkout, payout-eligible supplier account, and Clerk API key are
# disposable release fixtures: the smoke withdraws the publication and revokes the key.
AE_GATEWAY_SMOKE_CONFIRM_LIVE_SPEND=false
AE_GATEWAY_SMOKE_RUN_ID=
AE_GATEWAY_SMOKE_BASE_URL=
AE_GATEWAY_SMOKE_JOB_QUERY=
AE_GATEWAY_SMOKE_OWNER_QUERY=
AE_GATEWAY_SMOKE_INPUT_JSON=
AE_GATEWAY_SMOKE_API_KEY=
AE_GATEWAY_SMOKE_OWNER_BUSINESS_ID=
AE_GATEWAY_SMOKE_OWNER_BUSINESS_NAME=
AE_GATEWAY_SMOKE_OWNER_CLERK_SESSION_ID=
AE_GATEWAY_SMOKE_OWNER_CLERK_USER_ID=
AE_GATEWAY_SMOKE_CONTROL_BUSINESS_ID=
AE_GATEWAY_SMOKE_CREDENTIAL_ID=
AE_GATEWAY_SMOKE_APPROVED_AT=
AE_GATEWAY_SMOKE_TOPUP_STAGE=prepare
AE_GATEWAY_SMOKE_TOPUP_PREPARATION_PATH=output/release/operation-gateway-topup-preparation.json
AE_GATEWAY_SMOKE_TOPUP_AMOUNT_JSON=
AE_GATEWAY_SMOKE_PAYOUT_REF=
AE_GATEWAY_SMOKE_PAYOUT_IDEMPOTENCY_KEY=
AE_GATEWAY_SMOKE_OUTPUT_PATH=output/release/operation-gateway-smoke.json
AE_RELEASE_SOURCE_REVISION=
AE_RELEASE_DEPLOYMENT_ID=
AE_RELEASE_CONVEX_DEPLOYMENT_ID=
AE_RELEASE_CONVEX_URL=
# Optional HMAC/receipt keyrings used by answer sharing and inquiry access.
AE_ANSWER_THREAD_SHARE_SECRET=
AE_ANSWER_THREAD_SHARE_KEY_ID=
AE_INQUIRY_ACCESS_SECRET=
AE_INQUIRY_ACCESS_KEY_ID=
AE_GOVERNED_SEND_INTEGRITY_SECRET=
AE_GOVERNED_SEND_INTEGRITY_KEY_ID=
AE_GOVERNED_SEND_INTEGRITY_VERIFICATION_KEYS=
AE_INQUIRY_RECEIPT_KEK=
AE_INQUIRY_RECEIPT_KEK_ID=
AE_CUSTOMER_REQUEST_JOURNEY_SIGNING_KEY=
AE_CUSTOMER_REQUEST_JOURNEY_PREVIOUS_PUBLIC_KEYS=

# Dev-only WBA source smoke. Ignored in production and only used by `npm run test:dev-smoke:wba-agent-door`.
# Local-only auth bypass. The server and browser helpers fail closed if enabled in production.
VITE_AE_DISABLE_CLERK_FOR_LOCAL_E2E=
AE_DEV_WBA_SMOKE_ENABLED=
AE_DEV_WBA_SMOKE_SECRET=
AE_DEV_WBA_SIGNATURE_AGENT=

# Production-safe WBA: comma-separated HTTPS Signature-Agent origins (additive to chatgpt.com).
AE_WBA_SIGNATURE_AGENT_ALLOWLIST=
# Public JWKS for GET /.well-known/http-message-signatures-directory (single JWK or { "keys": [...] }; never include private `d`).
AE_WBA_DIRECTORY_PUBLIC_JWK_JSON=
# Comma-separated agentPrincipal:* ids allowed to call inquiry.submit (public_inquiry) after WBA verify.
AE_AGENT_PUBLIC_INQUIRY_ADMISSION_PRINCIPALS=

# Canonical public URL routing. Values are provisioned per deployment; keep names only here.
AE_CANONICAL_BASE_URL=
AE_CANONICAL_HOST_ALLOWLIST=
AE_CSP_REPORT_ONLY=

# Billing providers. Secrets stay server-only; provider readiness is proven by source-owned readback rows, not env presence.
# Production provider API calls enforce the provider host allowlist: Autumn api.useautumn.com, Stripe api.stripe.com.
# Non-production may use localhost/mock base URL overrides for tests and local provider stubs.
AUTUMN_SECRET_KEY=
AUTUMN_WEBHOOK_SECRET=
AUTUMN_ENVIRONMENT=sandbox
AUTUMN_PROJECT_ID=
AUTUMN_API_BASE_URL=https://api.useautumn.com
AUTUMN_API_VERSION=2.3.0
AUTUMN_PORTAL_RETURN_BASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=
# Phase 2 notification providers. Server-only secrets; provider readiness requires source-owned dispatch/webhook readback, not env presence.
RESEND_API_KEY=
RESEND_FROM=
RESEND_API_BASE_URL=https://api.resend.com
RESEND_WEBHOOK_SECRET=
AE_NOTIFICATION_OUTBOX_SECRET=
# Novu API key used by the primary notification dispatch route.
NOVU_SECRET_KEY=
# Optional Novu API host override for local/provider smoke tests.
NOVU_API_BASE_URL=https://api.novu.co
# Novu workflow id for owner-recipient inquiry notifications.
NOVU_WORKFLOW_INQUIRY_OWNER=
# Novu workflow id for customer-recipient inquiry notifications.
NOVU_WORKFLOW_INQUIRY_CUSTOMER=

# Structured answer (OpenRouter + TanStack AI). Server-only.
OPENROUTER_API_KEY=
AE_LLM_MODEL=deepseek/deepseek-v4-flash
# Set to 1 after `npm run test:eval` passes. Unlocks LLM follow-up chips.
# CI/release: run test:eval first, then export AE_ANSWER_EVAL_PASSED=1 for gated features.
AE_ANSWER_EVAL_PASSED=
# Optional comma-separated whitelist for the chat model selector (OpenRouter model ids).
AE_LLM_MODELS=
# Client answer mode: structured.
VITE_AE_ANSWER_MODE=structured


# Observability. PostHog owns funnel analytics; Sentry owns errors. Owner activation milestones stay in Convex.
VITE_SENTRY_DSN=
SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_APP_URL=
POSTHOG_APP_URL=
# Set to true in local e2e to skip third-party telemetry.
# Set to true only as an emergency server-side telemetry brake.
AE_DISABLE_OBSERVABILITY=
VITE_AE_DISABLE_OBSERVABILITY=
# Emergency server-side brake for public funnel writes to Convex.
AE_DISABLE_PUBLIC_FUNNEL_SOURCE_SYNC=


# Optional sandbox provider route authentication.
AE_SANDBOX_PROVIDER_KEY=
# Optional: Google Maps embed for generative location-map artifacts and office maps
VITE_GOOGLE_MAPS_API_KEY=
AE_ROUTING_PUBLIC_BASE_URL=https://ae-routing-edge.example.workers.dev
