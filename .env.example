# Clerk TanStack Start keys. See https://clerk.com/docs/tanstack-react-start/getting-started/quickstart
VITE_CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=

# Convex + Clerk issuer. See https://docs.convex.dev/auth/clerk
VITE_CONVEX_URL=
# Source-write trust envelope. Production must configure each scoped family as `keyId:secret`.
# Non-production may use AE_SOURCE_WRITE_SECRET to derive distinct family keys with HKDF.
AE_SOURCE_WRITE_SECRET=
AE_SOURCE_WRITE_KEY_INQUIRY=
AE_SOURCE_WRITE_PREVIOUS_KEYS_INQUIRY=
AE_SOURCE_WRITE_KEY_BILLING=
AE_SOURCE_WRITE_PREVIOUS_KEYS_BILLING=
AE_SOURCE_WRITE_KEY_PROTECTED=
AE_SOURCE_WRITE_PREVIOUS_KEYS_PROTECTED=
AE_SOURCE_WRITE_KEY_CLAIM=
AE_SOURCE_WRITE_PREVIOUS_KEYS_CLAIM=
AE_SOURCE_WRITE_KEY_OPERATOR=
AE_SOURCE_WRITE_PREVIOUS_KEYS_OPERATOR=
AE_SOURCE_WRITE_KEY_REPAIR=
AE_SOURCE_WRITE_PREVIOUS_KEYS_REPAIR=
AE_SOURCE_WRITE_KEY_SESSION=
AE_SOURCE_WRITE_PREVIOUS_KEYS_SESSION=
AE_SOURCE_WRITE_DERIVED_KEY_ID_INQUIRY=
AE_SOURCE_WRITE_PREVIOUS_DERIVED_KEY_IDS_INQUIRY=
AE_SOURCE_WRITE_DERIVED_KEY_ID_BILLING=
AE_SOURCE_WRITE_PREVIOUS_DERIVED_KEY_IDS_BILLING=
AE_SOURCE_WRITE_DERIVED_KEY_ID_PROTECTED=
AE_SOURCE_WRITE_PREVIOUS_DERIVED_KEY_IDS_PROTECTED=
AE_SOURCE_WRITE_DERIVED_KEY_ID_CLAIM=
AE_SOURCE_WRITE_PREVIOUS_DERIVED_KEY_IDS_CLAIM=
AE_SOURCE_WRITE_DERIVED_KEY_ID_OPERATOR=
AE_SOURCE_WRITE_PREVIOUS_DERIVED_KEY_IDS_OPERATOR=
AE_SOURCE_WRITE_DERIVED_KEY_ID_REPAIR=
AE_SOURCE_WRITE_PREVIOUS_DERIVED_KEY_IDS_REPAIR=
AE_SOURCE_WRITE_DERIVED_KEY_ID_SESSION=
AE_SOURCE_WRITE_PREVIOUS_DERIVED_KEY_IDS_SESSION=
CLERK_JWT_ISSUER_DOMAIN=

# Dev-only WBA source smoke. Ignored in production and only used by `npm run test:dev-smoke:wba-agent-door`.
AE_DEV_WBA_SMOKE_ENABLED=
AE_DEV_WBA_SMOKE_SECRET=
AE_DEV_WBA_SIGNATURE_AGENT=

# Canonical public URL routing. Values are provisioned per deployment; keep names only here.
AE_CANONICAL_BASE_URL=
AE_CANONICAL_HOST_ALLOWLIST=
AE_CSP_REPORT_ONLY=

# Billing providers. Secrets stay server-only; provider readiness is proven by source-owned readback rows, not env presence.
# Production provider API calls enforce the provider host allowlist: Autumn api.useautumn.com, Stripe api.stripe.com.
# Non-production may use localhost/mock base URL overrides for tests and local provider stubs.
AUTUMN_SECRET_KEY=
AUTUMN_WEBHOOK_SECRET=
AUTUMN_ENVIRONMENT=sandbox
AUTUMN_PROJECT_ID=
AUTUMN_API_BASE_URL=https://api.useautumn.com
AUTUMN_API_VERSION=2.3.0
AUTUMN_PORTAL_RETURN_BASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Phase 2 notification providers. Server-only secrets; provider readiness requires source-owned dispatch/webhook readback, not env presence.
RESEND_API_KEY=
RESEND_FROM=
RESEND_API_BASE_URL=https://api.resend.com
RESEND_WEBHOOK_SECRET=
AE_NOTIFICATION_OUTBOX_SECRET=
NOVU_SECRET_KEY=
NOVU_API_BASE_URL=https://api.novu.co
NOVU_WORKFLOW_INQUIRY_OWNER=
NOVU_WORKFLOW_INQUIRY_CUSTOMER=

# Structured answer (OpenRouter + TanStack AI). Server-only.
OPENROUTER_API_KEY=
AE_LLM_MODEL=deepseek/deepseek-v4-flash
# Server synthesizer: deterministic (default) | gated-llm (requires OPENROUTER_API_KEY + eval sign-off)
AE_ANSWER_SYNTHESIZER=deterministic
# Or: AE_GATED_LLM_ANSWER=1
# Set to 1 after `npm run test:eval` passes. Unlocks LLM follow-up chips.
# CI/release: run test:eval first, then export AE_ANSWER_EVAL_PASSED=1 for gated features.
AE_ANSWER_EVAL_PASSED=
# Optional comma-separated whitelist for the chat model selector (OpenRouter model ids).
AE_LLM_MODELS=
# Client: deterministic (default) | structured | openui
VITE_AE_ANSWER_MODE=deterministic

# Phase 7.2 search mirror. Convex remains source of truth; Meili is a generated mirror.
MEILISEARCH_HOST=
MEILISEARCH_ADMIN_KEY=
AE_SEARCH_INDEX_UID=registry-search-documents
# convex | dual | meilisearch. Start rollout in dual.
AE_SEARCH_BACKEND=dual
AE_SEARCH_TIMEOUT_MS=1500

# Observability. PostHog owns funnel analytics; Sentry owns errors. Owner activation milestones stay in Convex.
VITE_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_APP_URL=
POSTHOG_APP_URL=
# Set to true in local e2e to skip third-party telemetry.
VITE_AE_DISABLE_OBSERVABILITY=

# Optional: Google Maps embed for generative location-map artifacts and office maps
VITE_GOOGLE_MAPS_API_KEY=
