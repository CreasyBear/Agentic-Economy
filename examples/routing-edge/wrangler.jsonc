{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ae-routing-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-12",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AE_ROUTING_ORIGIN": "https://loyal-peacock-107.convex.site",
    "AE_EDGE_ENVIRONMENT": "staging",
    "AE_EDGE_SOURCE_REVISION": "local"
  },
  "secrets": {
    "required": ["AE_EDGE_ORIGIN_HMAC_KEY"]
  },
  "limits": {
    "cpu_ms": 50
  },
  "observability": {
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "env": {
    "production": {
      "name": "ae-routing-edge-production",
      "vars": {
        "AE_ROUTING_ORIGIN": "https://formal-jaguar-441.convex.site",
        "AE_EDGE_ENVIRONMENT": "production",
        "AE_EDGE_SOURCE_REVISION": "unbound"
      },
      "secrets": {
        "required": ["AE_EDGE_ORIGIN_HMAC_KEY"]
      }
    }
  }
}
