{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/capability.mjs": { "maxDuration": 10 },
    "api/shippo-capability.mjs": { "maxDuration": 10 },
    "api/easypost-capability.mjs": { "maxDuration": 10 },
    "api/signature-directory.mjs": { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/capability", "destination": "/api/capability" },
    { "source": "/capability/shippo", "destination": "/api/shippo-capability" },
    { "source": "/capability/easypost", "destination": "/api/easypost-capability" },
    { "source": "/.well-known/http-message-signatures-directory", "destination": "/api/signature-directory" }
  ]
}
