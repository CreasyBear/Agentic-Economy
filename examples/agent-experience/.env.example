# Agent-experience audit — runner config (ADR-006)
# Copy to examples/agent-experience/.env and fill, or export in your shell.

# The AE origin the agent pings. Local dev by default; use the deployed origin
# for the actual Scope-1/GTM gate run.
AE_BASE_URL=http://127.0.0.1:3000

# The abstract goal (no checklist). Leave unset to use the built-in default.
# AE_AUDIT_GOAL=A person in Parramatta has a burst pipe and needs an emergency plumber. Find a fitting listed business and take the first real step toward contacting it on the person's behalf.

# --- Optional signed inquiry scenario ----------------------------------------
# Leave unset for deterministic/no-key runs; the scenario is reported as SKIP.
# When set, the target must also admit that signed principal server-side
# (for local dev smoke, AE_DEV_AGENT_TOOL_WRITE_ADMISSION=public_inquiry).
AE_AUDIT_SIGNATURE_AGENT=
AE_AUDIT_PRIVATE_JWK_JSON=

# --- Release gate mode --------------------------------------------------------
# `npm run audit:agent-experience:gate` passes only when a fresh deployed report
# in .planning/audits/agent-experience/ has grade >= this threshold and the ADR
# gate itself passed.
AE_AUDIT_GATE_MAX_AGE_DAYS=7
AE_AUDIT_GATE_MIN_GRADE=B

# --- Your Hermes agent (only needed for `--driver hermes`) -------------------
# Hermes is driven over an OpenAI-compatible chat/completions + tools endpoint
# (OpenRouter `nousresearch/hermes-*`, Nous Portal, Together, a local vLLM, ...).
# The runner POSTs to `${HERMES_BASE_URL}/chat/completions`. If your Hermes
# speaks a different protocol, swap callHermes() in run-audit.ts.
HERMES_BASE_URL=https://openrouter.ai/api/v1
HERMES_API_KEY=
HERMES_MODEL=nousresearch/hermes-4-405b
