  "narrative": {
    "northStar": "The Airbnb of agentic commerce.",
    "overview": "Agentic Economy is a marketplace-shaped trust journey for agentic commerce: beautiful service listings, plain proof, explicit limits, and safe next actions. It connects people and agents to source-verified business actions they can understand and act on with confidence.",
    "keyCharacteristics": [
      "Imagery carries the story; UI gets out of the way.",
      "Linen surfaces with one coral accent for action and warmth.",
      "Cards feel like listings: image first, metadata second, action last.",
      "Trust is shown through verified badges, source labels, and honest boundaries.",
      "Motion is soft, physical, and purposeful."
    ],
    "rules": [
      { "name": "The One Coral Rule", "body": "Coral is the only brand accent. Use it for the primary CTA, selected state, focus, and one emotional highlight per page.", "section": "colors" },
      { "name": "The Trust-By-Text Rule", "body": "Verification and boundaries are always explained in words. Badges alone are not enough.", "section": "colors" },
      { "name": "The No Cool-Blue Rule", "body": "Signal cobalt and command-ink palettes are retired. No blue accents on public surfaces except functional links.", "section": "colors" },
      { "name": "The Hover-Lift Rule", "body": "Only truly interactive cards lift on hover. Static cards stay flat.", "section": "elevation" }
    ],
    "dos": [
      "Do lead with imagery and human copy on public surfaces.",
      "Do use listing-style cards for discovery moments.",
      "Do show trust through badges, source labels, and explicit boundaries.",
      "Do test every route at 375px and wide desktop.",
      "Do prefer real or generated images over div-based fake screenshots."
    ],
    "donts": [
      "Don't use the old civic blue/ink/command-panel palette.",
      "Don't use grid lines, hairline technical diagrams, or dark authority panels on public pages.",
      "Don't add payments, wallet, marketplace settlement, seller payouts, hosted agents, request market, MCP, OpenAPI, or callable UI claims before phase gates.",
      "Don't use hero metrics, fake dashboard previews, AI-purple gradients, or decorative glassmorphism.",
      "Don't animate non-interactive cards as if they lift."
    ]
  }
