{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "off"
  },
  "plugins": ["typescript", "oxc"],
  "rules": {
    "no-debugger": "error",
    "no-control-regex": "off",
    "no-underscore-dangle": "off",
    "no-unused-vars": "error",
    "no-useless-escape": "off",
    "typescript/triple-slash-reference": "off"
  },
  "ignorePatterns": [
    "convex/_generated/**",
    "tests/fixtures/**",
    "vendor/**"
  ]
}
