cloudflare_account_id = "replace-with-cloudflare-account-id"
cloudflare_zone_id    = "replace-with-cloudflare-zone-id"
source_revision       = "0000000000000000000000000000000000000000"

# Keep false by default. For each reviewed saved plan, explicitly acknowledge
# sandbox-only hosted waitlist alpha and verify live CIDR/state/DNS isolation.
# This acknowledges the alpha boundary; it does not authorize production money
# or assert that the app, ledger schema, alert delivery or recovery is ready.
alpha_sandbox_acknowledged = false

# Supply provider credentials through their normal environment or credential
# chain. Do not copy credentials or synthetic release profiles from Package 4.
# The application_binding output describes the current app's hosted_alpha mode;
# initialize its new sandbox ledger and supply fresh Access credentials plus the
# app's required request timeout separately before enabling waitlist traffic.
