{
  "name": "agentic-economy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "ae": "tsx tools/ae/cli.ts",
    "parity:check": "node eval/parity/check-parity.mjs",
    "audit:actions": "node scripts/audit-action-surfaces.mjs",
    "dev": "vite dev --host 127.0.0.1",
    "dev:local": "node tools/dev/local-dev.mjs",
    "dev:local:source": "node tools/dev/local-source-write-secret.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src convex tests tools --deny-warnings",
    "check:convex-codegen": "convex codegen --dry-run --typecheck=disable",
    "gate:release": "npm run test:release:source",
    "test:release:unit": "vitest run tests/unit --reporter=default --reporter=json --outputFile.json=output/release/unit-vitest.json",
    "test:release:integration": "vitest run tests/integration convex/customerRequestRouteMandate.test.ts --no-file-parallelism --reporter=default --reporter=json --outputFile.json=output/release/integration-vitest.json",
    "check:kernel-retirement": "node tools/release/verify-kernel-retirement.mjs",
    "seed:dev": "convex run devSeed:seedDevCatalog",
    "test:release": "npm run test:release:source && npm run test:release:hosted",
    "test:release:source": "mkdir -p output/release && npm run check:convex-codegen && npm run test:release:source:after-codegen",
    "test:release:source:after-codegen": "npm run lint && npm run typecheck && npm run check:kernel-retirement && npm run test:release:unit && npm run test:release:integration && npm run test:types && npm run test:imports && npm run test:ts-standards && npm run test:seo && npm run test:ui-contract && npm run test:eval:report && npm run build",
    "test:release:hosted": "npm run test:release:hosted:readback && npm run smoke:customer-request:production:temporary-key && npm run smoke:customer-request:production:human",
    "test:release:hosted:readback": "tsx tools/release/verify-customer-request-release-credential.ts",
    "smoke:customer-request:production": "tsx tools/release/customer-request-production-smoke.ts",
    "smoke:customer-request:development": "tsx tools/dev/customer-request-development-smoke.ts",
    "smoke:work-tree:development": "tsx tools/dev/work-tree-development-smoke.ts",
    "smoke:work-tree:production:hosted": "npx playwright test --config=playwright.deploy-smoke.config.ts tests/deploy-smoke/work-tree-parity-release-proof.spec.ts --project=deploy-smoke",
    "smoke:customer-request:development:surface-parity": "tsx tools/dev/customer-request-development-surface-parity.ts",
    "evidence:action-invocation:development": "tsx tools/dev/action-invocation-development-evidence.ts",
    "evidence:operation:development": "tsx tools/dev/development-provider-operation-evidence.ts",
    "evidence:bounded-mandate:development": "tsx tools/dev/bounded-mandate-evidence-packet.ts",
    "evidence:full-yolo:development": "tsx tools/dev/full-yolo-evidence-packet.ts",
    "smoke:customer-request:production:temporary-key": "tsx tools/release/customer-request-production-credential.ts",
    "smoke:customer-request:production:human": "playwright test --config=playwright.deploy-smoke.config.ts tests/deploy-smoke/customer-request-human-lifecycle-smoke.spec.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration convex/customerRequestRouteMandate.test.ts --no-file-parallelism",
    "test:eval": "npm run test:eval:coverage && npm run test:eval:report && PROMPTFOO_CONFIG_DIR=.promptfoo-home PROMPTFOO_DISABLE_WAL_MODE=true promptfoo eval -c eval/answer/promptfooconfig.yaml --no-cache && vitest run tests/eval",
    "test:eval:coverage": "tsx eval/answer/scripts/audit-coverage.ts",
    "test:eval:report": "tsx eval/answer/scripts/run-suite.ts --output output/eval/answer-suite-report.json",
    "test:eval:validate": "npm run test:eval:coverage && PROMPTFOO_CONFIG_DIR=.promptfoo-home PROMPTFOO_DISABLE_WAL_MODE=true promptfoo validate -c eval/answer/promptfooconfig.yaml",
    "test:e2e": "playwright test tests/e2e",
    "test:e2e:paid-operation": "playwright test --config=playwright.paid-operation.config.ts tests/e2e/paid-operation-development-surface.spec.ts",
    "test:provider-smoke:resend": "playwright test --config=playwright.deploy-smoke.config.ts tests/deploy-smoke/phase2-resend-dispatch-smoke.spec.ts",
    "test:provider-smoke:novu": "playwright test --config=playwright.deploy-smoke.config.ts tests/deploy-smoke/phase2-novu-dispatch-smoke.spec.ts",
    "test:e2e:a11y": "playwright test tests/e2e/a11y",
    "test:types": "vitest run tests/types",
    "test:imports": "AE_SCAN_MODE=clean vitest run tests/imports/backup-imports.test.ts tests/imports/private-imports.test.ts tests/imports/route-boundary.test.ts tests/imports/routing-authority-retirement.test.ts tests/imports/routing-kernel-boundaries.test.ts tests/imports/capability-contract-boundaries.test.ts tests/imports/capability-contract-registry-boundaries.test.ts tests/imports/capability-supply-boundaries.test.ts tests/imports/customer-request-boundaries.test.ts tests/imports/customer-request-source-completeness.test.ts tests/imports/kernel-retirement-manifest.test.ts tests/imports/legacy-engine-retirement.test.ts tests/imports/action-invocation-host-boundaries.test.ts tests/imports/paid-operation-development-surface-exclusion.test.ts",
    "test:imports:fixtures": "AE_SCAN_MODE=fixtures vitest run tests/imports/backup-imports.test.ts tests/imports/private-imports.test.ts tests/imports/route-boundary.test.ts",
    "test:ts-standards": "AE_SCAN_MODE=clean vitest run tests/imports/ts-standards.test.ts",
    "test:ts-standards:fixtures": "AE_SCAN_MODE=fixtures vitest run tests/imports/ts-standards.test.ts",
    "test:seo": "vitest run tests/seo",
    "test:ui-contract": "AE_SCAN_MODE=clean vitest run tests/ui-contract",
    "test:all": "npm run typecheck && npm run check:convex-codegen && npm run test:unit && npm run test:integration && npm run test:types && npm run test:imports && npm run test:ts-standards && npm run test:seo && npm run test:ui-contract && npm run build",
    "doctor": "npm exec --offline -- react-doctor"
  },
  "dependencies": {
    "@ai-sdk/provider-utils": "^5.0.16",
    "@cfworker/json-schema": "4.1.1",
    "@clerk/tanstack-react-start": "1.4.9",
    "@convex-dev/aggregate": "^0.2.2",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/workflow": "^0.4.4",
    "@convex-dev/workpool": "^0.4.9",
    "@flatten-js/interval-tree": "^2.0.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@noble/curves": "1.9.1",
    "@noble/hashes": "1.8.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sentry/node": "^10.63.0",
    "@sentry/react": "^10.63.0",
    "@sindresorhus/slugify": "^3.0.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/ai": "^0.38.0",
    "@tanstack/react-router": "1.170.16",
    "@tanstack/react-start": "1.168.26",
    "@tanstack/react-table": "^8.21.3",
    "@x402/core": "2.18.0",
    "@x402/evm": "2.18.0",
    "@x402/extensions": "2.18.0",
    "ai": "^7.0.44",
    "ajv": "8.20.0",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "convex": "1.42.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "es-toolkit": "^1.50.0",
    "fastest-levenshtein": "^1.0.16",
    "graphology": "^0.26.0",
    "graphology-dag": "^0.4.1",
    "graphology-traversal": "^0.3.1",
    "lucide-react": "^1.21.0",
    "motion": "^12.42.0",
    "nanoid": "^5.1.16",
    "posthog-js": "^1.398.2",
    "posthog-node": "^5.39.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.7",
    "react-arborist": "^3.16.0",
    "react-dom": "19.2.7",
    "shiki": "^3.23.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "undici": "7.28.0",
    "use-stick-to-bottom": "^1.1.6",
    "viem": "2.55.2",
    "xstate": "^5.32.5",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@sentry/vite-plugin": "^5.3.0",
    "@tailwindcss/vite": "4.3.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "convex-test": "^0.0.54",
    "jsdom": "29.1.1",
    "nitro": "npm:nitro-nightly@^3.0.1-20260628-090458-3df69609",
    "oxlint": "^1.73.0",
    "promptfoo": "^0.121.17",
    "react-doctor": "^0.7.7",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.20.5",
    "typescript": "6.0.3",
    "vite": "8.1.0",
    "vitest": "4.1.9"
  },
  "overrides": {
    "@opentelemetry/exporter-trace-otlp-http": "0.219.0",
    "shiki": "^3.23.0",
    "@shikijs/types": "^3.23.0",
    "@shikijs/core": "^3.23.0",
    "@shikijs/langs": "^3.23.0",
    "@shikijs/themes": "^3.23.0",
    "@shikijs/engine-javascript": "^3.23.0",
    "@shikijs/engine-oniguruma": "^3.23.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.5.1"
}
