{
  "name": "agentic-economy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "provider:readiness": "node examples/routing-provider/run-provider-readiness.mjs",
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "start": "vite start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src convex tests tools examples --deny-warnings",
    "check:convex-codegen": "convex codegen --dry-run --typecheck=disable",
    "check:kernel-proof": "node tools/release/verify-kernel-proof-manifest.mjs",
    "check:kernel-retirement": "node tools/release/verify-kernel-retirement.mjs",
    "check:routing-edge": "cd examples/routing-edge && wrangler types --check && tsc -p tsconfig.json && wrangler deploy --dry-run --env=\"\"",
    "seed:dev": "convex run devSeed:seedDevCatalog",
    "test:release": "npm run test:release:source && npm run test:release:hosted",
    "test:release:source": "npm run lint && npm run typecheck && npm run check:routing-edge && npm run check:kernel-retirement && npm run test:unit && npm run test:integration && npm run test:types && npm run test:imports && npm run test:ts-standards && npm run test:copy && npm run test:seo && npm run test:ui-contract && npm run build",
    "test:release:hosted": "npm run test:release:hosted:readback && npm run smoke:customer-request:production:temporary-key && npm run smoke:customer-request:production:human",
    "test:release:hosted:readback": "tsx tools/release/verify-customer-request-release-credential.ts",
    "smoke:customer-request:production": "tsx tools/release/customer-request-production-smoke.ts",
    "smoke:customer-request:development": "tsx tools/dev/customer-request-development-smoke.ts",
    "smoke:customer-request:business-problem": "tsx tools/dev/customer-request-business-problem-smoke.ts",
    "smoke:customer-request:development:surface-parity": "tsx tools/dev/customer-request-development-surface-parity.ts",
    "smoke:customer-request:production:temporary-key": "tsx tools/release/customer-request-production-credential.ts",
    "smoke:customer-request:production:human": "playwright test --config=playwright.deploy-smoke.config.ts tests/deploy-smoke/customer-request-human-lifecycle-smoke.spec.ts",
    "smoke:customer-request:production:preflight": "tsx tools/release/customer-request-production-smoke.ts --preflight",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration convex/customerRequestRouteMandate.test.ts --no-file-parallelism",
    "test:eval": "npm run test:eval:coverage && npm run test:eval:report && PROMPTFOO_CONFIG_DIR=.promptfoo-home PROMPTFOO_DISABLE_WAL_MODE=true promptfoo eval -c eval/answer/promptfooconfig.yaml --no-cache && vitest run tests/eval",
    "test:eval:coverage": "node --import tsx eval/answer/scripts/audit-coverage.ts",
    "test:eval:report": "node --import tsx eval/answer/scripts/run-suite.ts --output output/eval/answer-suite-report.json",
    "test:eval:live-api": "node --import tsx eval/answer/scripts/run-live-api-study.ts --output output/eval/live-api-study.json",
    "test:eval:validate": "npm run test:eval:coverage && PROMPTFOO_CONFIG_DIR=.promptfoo-home PROMPTFOO_DISABLE_WAL_MODE=true promptfoo validate -c eval/answer/promptfooconfig.yaml",
    "test:e2e": "playwright test tests/e2e",
    "test:deploy-smoke:public": "playwright test --config=playwright.deploy-smoke.config.ts tests/deploy-smoke/public-surface-smoke.spec.ts",
    "test:deploy-smoke:inquiry-support": "playwright test --config=playwright.deploy-smoke.config.ts tests/deploy-smoke/inquiry-support-record-smoke.spec.ts",
    "test:provider-smoke:resend": "playwright test --config=playwright.deploy-smoke.config.ts tests/deploy-smoke/resend-notification-smoke.spec.ts",
    "test:provider-smoke:novu": "playwright test --config=playwright.deploy-smoke.config.ts tests/deploy-smoke/novu-notification-smoke.spec.ts",
    "test:e2e:a11y": "playwright test tests/e2e/a11y",
    "test:a11y": "playwright test tests/e2e/a11y",
    "test:types": "vitest run tests/types",
    "test:imports": "AE_SCAN_MODE=clean vitest run tests/imports/backup-imports.test.ts tests/imports/private-imports.test.ts tests/imports/route-boundary.test.ts tests/imports/routing-authority-retirement.test.ts tests/imports/routing-kernel-boundaries.test.ts tests/imports/capability-contract-boundaries.test.ts tests/imports/capability-contract-registry-boundaries.test.ts tests/imports/capability-supply-boundaries.test.ts tests/imports/customer-request-boundaries.test.ts tests/imports/customer-request-source-completeness.test.ts tests/imports/kernel-retirement-manifest.test.ts",
    "test:imports:fixtures": "AE_SCAN_MODE=fixtures vitest run tests/imports/backup-imports.test.ts tests/imports/private-imports.test.ts tests/imports/route-boundary.test.ts",
    "test:ts-standards": "AE_SCAN_MODE=clean vitest run tests/imports/ts-standards.test.ts",
    "test:ts-standards:fixtures": "AE_SCAN_MODE=fixtures vitest run tests/imports/ts-standards.test.ts",
    "test:copy": "vitest run tests/copy",
    "test:seo": "vitest run tests/seo",
    "test:ui-contract": "AE_SCAN_MODE=clean vitest run tests/ui-contract",
    "test:all": "npm run typecheck && npm run check:convex-codegen && npm run test:unit && npm run test:integration && npm run test:types && npm run test:imports && npm run test:ts-standards && npm run test:copy && npm run test:seo && npm run test:ui-contract && npm run build",
    "doctor": "npx react-doctor@latest",
    "audit:agent-experience": "node examples/routing-provider/run-hosted-tracer.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.1.2",
    "@astryxdesign/theme-neutral": "^0.1.2",
    "@cfworker/json-schema": "4.1.1",
    "@clerk/tanstack-react-start": "1.4.9",
    "@noble/curves": "1.9.1",
    "@noble/hashes": "1.8.0",
    "@sentry/node": "^10.63.0",
    "@sentry/react": "^10.63.0",
    "@tanstack/ai": "^0.38.0",
    "@tanstack/react-router": "1.170.16",
    "@tanstack/react-start": "1.168.26",
    "@tanstack/react-table": "^8.21.3",
    "@x402/core": "2.18.0",
    "@x402/evm": "2.18.0",
    "@x402/extensions": "2.18.0",
    "ajv": "8.20.0",
    "clsx": "2.1.1",
    "convex": "1.42.0",
    "http-message-sig": "^0.2.0",
    "lucide-react": "^1.21.0",
    "motion": "^12.42.0",
    "posthog-js": "^1.398.2",
    "posthog-node": "^5.39.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "undici": "7.28.0",
    "viem": "2.55.2",
    "web-bot-auth": "0.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.1.2",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "1.61.1",
    "@sentry/vite-plugin": "^5.3.0",
    "@tailwindcss/vite": "4.3.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "convex-test": "^0.0.54",
    "jsdom": "29.1.1",
    "nitro": "npm:nitro-nightly@^3.0.1-20260628-090458-3df69609",
    "node-addon-api": "^8.9.0",
    "node-gyp": "^12.4.0",
    "oxlint": "^1.73.0",
    "promptfoo": "^0.121.17",
    "react-doctor": "^0.7.7",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.20.5",
    "typescript": "6.0.3",
    "vite": "8.1.0",
    "vitest": "4.1.9",
    "wrangler": "^4.110.0"
  },
  "overrides": {
    "@opentelemetry/exporter-trace-otlp-http": "0.219.0"
  },
  "packageManager": "npm@11.5.1"
}
