{
  "name": "agentic-economy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "workspaces": [
    "packages/cli"
  ],
  "scripts": {
    "ae": "tsx tools/ae/cli.ts",
    "build:cli": "npm run build --workspace @agentic-economy/cli",
    "pack:cli:public": "npm run build:cli && mkdir -p ./public/downloads && npm pack ./packages/cli --pack-destination ./public/downloads",
    "test:cli-package": "npm test --workspace @agentic-economy/cli",
    "audit:actions": "node scripts/audit-action-surfaces.mjs",
    "dev": "vite dev --host 127.0.0.1",
    "dev:local": "node tools/dev/require-supported-node.mjs -- node tools/dev/local-dev.mjs",
    "connect:local": "node tools/dev/local-connect.mjs",
    "env:example": "tsx tools/release/render-env-example.ts",
    "env:example:check": "tsx tools/release/render-env-example.ts --check",
    "build": "npm run pack:cli:public && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src convex tests tools --deny-warnings",
    "generate:convex": "node tools/dev/require-supported-node.mjs -- convex codegen --typecheck=disable",
    "check:convex-codegen": "node tools/dev/require-supported-node.mjs -- convex codegen --dry-run --typecheck=disable",
    "verify:convex-generated:anonymous": "tsx tools/release/verify-convex-generated-anonymous.ts",
    "verify:release-integrity": "tsx tools/release/verify-release-integrity.ts -- npm run build",
    "gate:anatomy": "node tools/dev/require-supported-node.mjs -- npm run --silent gate:anatomy:legs",
    "gate:anatomy:legs": "npx vitest run tests/integration/discovery-route-parity.test.ts tests/unit/http/problem-envelope-drift.test.ts --no-file-parallelism && npm run test:imports && npm run test:ui-contract",
    "test:release:unit": "node tools/dev/run-with-cleanup.mjs vitest run tests/unit --reporter=default --reporter=json --outputFile.json=output/release/unit-vitest.json",
    "test:release:integration": "node tools/dev/run-with-cleanup.mjs vitest run tests/integration convex --no-file-parallelism --test-timeout=15000 --reporter=default --reporter=json --outputFile.json=output/release/integration-vitest.json",
    "test:release:architecture": "node tools/dev/run-with-cleanup.mjs vitest run tests/integration/canonical-tool-reads.test.ts tests/integration/current-tool-snapshot-stability.test.ts --no-file-parallelism --test-timeout=60000",
    "verify:deployment-manifest": "tsx tools/release/verify-deployment-manifest.ts",
    "test:conformance": "node tools/dev/run-listed-vitest.mjs tests/unit/action-execution/durable-action-execution-transact.test.ts tests/unit/action-execution/durable-action-execution-lease.test.ts tests/unit/action-execution/durable-action-execution-release.test.ts tests/unit/action-execution/durable-action-execution-cancel.test.ts tests/unit/action-execution/durable-action-execution-observation.test.ts tests/unit/action-execution/durable-action-execution-result.test.ts tests/unit/capability-execution/call-admit.test.ts tests/unit/capability-execution/call-dispatch.test.ts tests/unit/capability-execution/call-recover.test.ts tests/unit/capability-execution/call-recovery-actions.test.ts tests/unit/convex/capability-call-recovery.test.ts tests/unit/convex/capability-call-worker-run.test.ts tests/unit/convex/capability-call-worker-reconcile.test.ts tests/unit/convex/capability-call-worker-charge.test.ts tests/unit/convex/capability-call-worker-lease.test.ts tests/integration/capability-call-workpool.test.ts tests/unit/server/call-api.test.ts tests/unit/capability-supply/provider-connection.test.ts tests/unit/capability-supply/route-transport-mcp.test.ts tests/unit/capability-supply/route-transport-x402.test.ts tests/unit/capability-supply/route-transport-call.test.ts tests/unit/capability-supply/route-transport-http-json.test.ts tests/unit/capability-supply/route-transport-cancel.test.ts tests/unit/capability-supply/route-transport-observation.test.ts tests/unit/capability-supply/readiness-probe-http-json.test.ts tests/unit/capability-supply/readiness-probe-mcp.test.ts tests/unit/capability-supply/readiness-probe-x402.test.ts tests/unit/capability-supply/readiness-probe-quote.test.ts tests/unit/capability-supply/eligible-supply.test.ts tests/unit/capability-supply/publication-importers-openapi.test.ts tests/unit/capability-supply/publication-importers-mcp.test.ts tests/unit/capability-supply/publication-importers-x402.test.ts tests/unit/capability-supply/provider-approval.test.ts tests/integration/capability-supply-owner-funnel-publish.test.ts tests/integration/capability-supply-owner-funnel-read.test.ts tests/integration/capability-supply-owner-funnel-run-test.test.ts tests/integration/capability-supply-owner-funnel-withdraw-republish.test.ts tests/integration/capability-supply-owner-funnel-reserve.test.ts tests/unit/deployment/deployment-manifest.test.ts tests/unit/server/diagnostic-routes.test.ts tests/unit/server/request-correlation.test.ts tests/unit/server/start-observability.test.ts",
    "test:chat:conformance": "mkdir -p output/release && node tools/dev/run-listed-vitest.mjs tests/unit/chat/convex-agent-component.test.ts tests/unit/chat/chat-agent-tools.test.ts tests/unit/chat/anonymous-chat-boundary.test.ts tests/unit/chat/chat-share-token.test.ts tests/unit/routes/chat-anonymous.test.ts tests/integration/chat-anonymous-transport.test.ts tests/integration/chat-durable-messaging-share.test.ts tests/integration/chat-thread-metadata.test.ts tests/unit/security/ssrf-surface-drift.test.ts tests/unit/chat/chat-provider-boundary.test.tsx tests/unit/routes/chat-routes.test.tsx -- --no-file-parallelism --test-timeout=15000 --reporter=default --reporter=json --outputFile.json=output/release/chat-conformance-vitest.json",
    "test:release": "npm run test:release:source",
    "test:release:source": "mkdir -p output/release && npm run verify:deployment-manifest -- --environment development && npm run env:example:check && npm run test:conformance && npm run test:chat:conformance && npm run verify:convex-generated:anonymous && npm run verify:release-integrity && npm run test:release:source:after-codegen",
    "gate": "node tools/dev/require-supported-node.mjs -- npm run test:release:source",
    "test:release:source:after-codegen": "npm run test:release:architecture && npm run lint && npm run typecheck && npm run test:release:unit && npm run test:release:integration && npm run test:types && npm run test:imports && npm run test:ts-standards && npm run test:seo && npm run test:ui-contract && npm run test:e2e && npm run test:e2e:a11y && npm run test:cli-package && npm run build",
    "test:release:authenticated": "npm run test:e2e:authenticated:required",
    "test:release:package5": "node tools/dev/run-with-cleanup.mjs vitest run tests/unit/release/package5-provider-operations.test.ts",
    "smoke:release:package5": "node tools/dev/run-with-cleanup.mjs tsx tools/release/package5-provider-operations.ts",
    "test:release:live-gateway": "npm run smoke:gateway:production --",
    "smoke:gateway:production": "node tools/dev/run-with-cleanup.mjs tsx tools/release/tool-gateway-production-smoke.ts",
    "smoke:chat:staging": "node tools/dev/run-with-cleanup.mjs playwright test --config=tests/config/playwright.chat-staging.config.ts",
    "validate:release:gateway": "tsx tools/release/validate-tool-gateway-production-smoke-receipt.ts",
    "evidence:action-execution:development": "tsx tools/dev/action-execution-development-evidence.ts",
    "evidence:tool:development": "tsx tools/dev/development-provider-tool-evidence.ts",
    "evidence:spending-policy:development": "tsx tools/dev/spending-policy-evidence-packet.ts",
    "evidence:unrestricted-test-only:development": "tsx tools/dev/unrestricted-test-only-evidence-packet.ts",
    "test": "node tools/dev/run-with-cleanup.mjs vitest run",
    "test:unit": "node tools/dev/run-with-cleanup.mjs vitest run tests/unit",
    "test:integration": "node tools/dev/run-with-cleanup.mjs vitest run tests/integration convex --no-file-parallelism",
    "test:eval": "node tools/dev/run-with-cleanup.mjs vitest run tests/eval",
    "test:e2e": "node tools/dev/run-with-cleanup.mjs playwright test tests/e2e",
    "test:e2e:a11y": "node tools/dev/run-with-cleanup.mjs playwright test tests/e2e/a11y --workers=1",
    "test:e2e:authenticated": "node tools/dev/run-with-cleanup.mjs playwright test --config=tests/config/playwright.authenticated.config.ts",
    "test:e2e:authenticated:required": "AE_REQUIRE_AUTHENTICATED_E2E=true node tools/dev/run-with-cleanup.mjs playwright test --config=tests/config/playwright.authenticated.config.ts",
    "test:types": "node tools/dev/run-with-cleanup.mjs vitest run tests/types",
    "test:imports": "npm run build:cli && AE_SCAN_MODE=clean node tools/dev/run-listed-vitest.mjs tests/imports/module-boundaries.test.ts tests/imports/chat-sharing-boundaries.test.ts tests/imports/backup-imports.test.ts tests/imports/private-imports.test.ts tests/imports/route-boundary.test.ts tests/imports/capability-contract-boundaries.test.ts tests/imports/capability-contract-registry-boundaries.test.ts tests/imports/capability-supply-boundaries.test.ts tests/imports/action-execution-host-boundaries.test.ts tests/imports/tool-surface-conformance.test.ts tests/imports/development-evidence-boundary.test.ts tests/imports/external-source-drift.test.ts",
    "test:imports:fixtures": "AE_SCAN_MODE=fixtures node tools/dev/run-with-cleanup.mjs vitest run tests/imports/backup-imports.test.ts tests/imports/private-imports.test.ts tests/imports/route-boundary.test.ts",
    "test:ts-standards": "AE_SCAN_MODE=clean node tools/dev/run-with-cleanup.mjs vitest run tests/imports/ts-standards.test.ts",
    "test:ts-standards:fixtures": "AE_SCAN_MODE=fixtures node tools/dev/run-with-cleanup.mjs vitest run tests/imports/ts-standards.test.ts",
    "test:seo": "node tools/dev/run-with-cleanup.mjs vitest run tests/seo",
    "test:ui-contract": "AE_SCAN_MODE=clean node tools/dev/run-with-cleanup.mjs vitest run tests/ui-contract",
    "doctor": "npm exec --offline -- react-doctor"
  },
  "dependencies": {
    "@ai-sdk/provider-utils": "^5.0.16",
