{
  "name": "agentic-economy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "ae": "tsx tools/ae/cli.ts",
    "parity:check": "node eval/parity/check-parity.mjs",
    "audit:actions": "node scripts/audit-action-surfaces.mjs",
    "dev": "vite dev --host 127.0.0.1",
    "papercut": "node tools/dev/papercut.mjs",
    "dev:local": "node tools/dev/local-dev.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src convex tests tools --deny-warnings",
    "check:convex-codegen": "convex codegen --dry-run --typecheck=disable",
    "gate:release": "npm run test:release:source",
    "test:release:unit": "node tools/dev/run-with-cleanup.mjs vitest run tests/unit --reporter=default --reporter=json --outputFile.json=output/release/unit-vitest.json",
    "test:release:integration": "node tools/dev/run-with-cleanup.mjs vitest run tests/integration convex --no-file-parallelism --test-timeout=15000 --reporter=default --reporter=json --outputFile.json=output/release/integration-vitest.json",
    "check:kernel-retirement": "node tools/release/verify-kernel-retirement.mjs",
    "check:product-frontier": "node tools/release/verify-product-frontier.mjs",
    "verify:deployment-manifest": "tsx tools/release/verify-deployment-manifest.ts",
    "test:conformance": "vitest run tests/unit/action-invocation/durable-action-invocation.test.ts tests/unit/action-invocation/dynamic-published-operation.test.ts tests/unit/action-invocation/paid-operation-provider-selection.test.ts tests/unit/action-invocation/x402-payment-reconciliation.test.ts tests/unit/capability-execution/operation-invoke.test.ts tests/unit/capability-execution/operation-recovery-actions.test.ts tests/unit/convex/capability-operation-recovery.test.ts tests/unit/convex/capability-operation-worker.test.ts tests/integration/capability-operation-workpool.test.ts tests/unit/server/operation-invoke-api.test.ts tests/unit/capability-supply/provider-connection.test.ts tests/unit/capability-supply/route-transport-runtime.test.ts tests/unit/capability-supply/readiness-probe.test.ts tests/unit/capability-supply/eligible-supply.test.ts tests/unit/capability-supply/publication-importers.test.ts tests/unit/capability-supply/provider-approval.test.ts tests/unit/capability-supply/published-operation-provider-conformance.test.ts tests/unit/capability-supply/provider-conformance-evidence.test.ts tests/integration/capability-supply-owner-funnel.test.ts tests/unit/answer-thread/answer-harness-operation.test.ts tests/unit/answer-thread/answer-turn-checkpoint.test.ts tests/unit/answer-thread/answer-turn-finalization-convergence.test.ts tests/integration/answer-thread-source-write.test.ts tests/unit/deployment/deployment-manifest.test.ts tests/unit/server/diagnostic-routes.test.ts tests/unit/server/request-correlation.test.ts tests/unit/server/start-observability.test.ts",
    "seed:dev": "convex run devSeed:seedDevCatalog",
    "test:release": "npm run test:release:source && npm run test:release:hosted",
    "test:release:source": "mkdir -p output/release && npm run verify:deployment-manifest -- --environment production && npm run test:conformance && npm run check:convex-codegen && npm run test:release:source:after-codegen",
    "test:release:source:after-codegen": "npm run lint && npm run typecheck && npm run check:kernel-retirement && npm run check:product-frontier && npm run test:release:unit && npm run test:release:integration && npm run test:types && npm run test:imports && npm run test:ts-standards && npm run test:seo && npm run test:ui-contract && npm run test:eval:report && npm run build",
    "test:release:hosted": "npm run test:release:hosted:request",
    "test:release:hosted:request": "npm run test:release:hosted:readback && npm run smoke:customer-request:production:temporary-key && npm run smoke:customer-request:production:human",
    "test:release:hosted:live-gateway": "npm run smoke:gateway:production",
    "test:release:hosted:readback": "node tools/dev/run-with-cleanup.mjs tsx tools/release/verify-customer-request-release-credential.ts",
    "smoke:customer-request:production": "node tools/dev/run-with-cleanup.mjs tsx tools/release/customer-request-production-smoke.ts",
    "smoke:gateway:production": "node tools/dev/run-with-cleanup.mjs tsx tools/release/operation-gateway-production-smoke.ts",
    "validate:release:hosted:gateway": "tsx tools/release/validate-operation-gateway-production-smoke-receipt.ts",
    "smoke:customer-request:development": "node tools/dev/run-with-cleanup.mjs tsx tools/dev/customer-request-development-smoke.ts",
    "smoke:work-tree:development": "node tools/dev/run-with-cleanup.mjs tsx tools/dev/work-tree-development-smoke.ts",
    "smoke:customer-request:development:surface-parity": "node tools/dev/run-with-cleanup.mjs tsx tools/dev/customer-request-development-surface-parity.ts",
    "evidence:action-invocation:development": "tsx tools/dev/action-invocation-development-evidence.ts",
    "evidence:operation:development": "tsx tools/dev/development-provider-operation-evidence.ts",
    "evidence:bounded-mandate:development": "tsx tools/dev/bounded-mandate-evidence-packet.ts",
    "evidence:full-yolo:development": "tsx tools/dev/full-yolo-evidence-packet.ts",
    "smoke:customer-request:production:temporary-key": "node tools/dev/run-with-cleanup.mjs tsx tools/release/customer-request-production-credential.ts",
    "smoke:customer-request:production:human": "node tools/dev/run-with-cleanup.mjs playwright test --config=playwright.deploy-smoke.config.ts tests/deploy-smoke/customer-request-human-lifecycle-smoke.spec.ts",
    "test": "node tools/dev/run-with-cleanup.mjs vitest run",
    "test:unit": "node tools/dev/run-with-cleanup.mjs vitest run tests/unit",
    "test:integration": "node tools/dev/run-with-cleanup.mjs vitest run tests/integration convex --no-file-parallelism",
    "test:eval": "npm run test:eval:coverage && npm run test:eval:report && PROMPTFOO_CONFIG_DIR=.promptfoo-home PROMPTFOO_DISABLE_WAL_MODE=true node tools/dev/run-with-cleanup.mjs promptfoo eval -c eval/answer/promptfooconfig.yaml --no-cache && node tools/dev/run-with-cleanup.mjs vitest run tests/eval",
    "test:eval:coverage": "node tools/dev/run-with-cleanup.mjs tsx eval/answer/scripts/audit-coverage.ts",
    "test:eval:report": "node tools/dev/run-with-cleanup.mjs tsx eval/answer/scripts/run-suite.ts --output output/eval/answer-suite-report.json",
    "test:eval:validate": "npm run test:eval:coverage && PROMPTFOO_CONFIG_DIR=.promptfoo-home PROMPTFOO_DISABLE_WAL_MODE=true node tools/dev/run-with-cleanup.mjs promptfoo validate -c eval/answer/promptfooconfig.yaml",
    "test:e2e": "node tools/dev/run-with-cleanup.mjs playwright test tests/e2e",
    "test:e2e:paid-operation": "node tools/dev/run-with-cleanup.mjs playwright test --config=playwright.paid-operation.config.ts tests/e2e/paid-operation-development-surface.spec.ts",
    "test:provider-smoke:resend": "node tools/dev/run-with-cleanup.mjs playwright test --config=playwright.deploy-smoke.config.ts tests/deploy-smoke/phase2-resend-dispatch-smoke.spec.ts",
    "test:provider-smoke:novu": "node tools/dev/run-with-cleanup.mjs playwright test --config=playwright.deploy-smoke.config.ts tests/deploy-smoke/phase2-novu-dispatch-smoke.spec.ts",
    "test:e2e:a11y": "node tools/dev/run-with-cleanup.mjs playwright test tests/e2e/a11y",
    "test:types": "node tools/dev/run-with-cleanup.mjs vitest run tests/types",
    "test:imports": "AE_SCAN_MODE=clean node tools/dev/run-with-cleanup.mjs vitest run tests/imports/backup-imports.test.ts tests/imports/private-imports.test.ts tests/imports/route-boundary.test.ts tests/imports/routing-authority-retirement.test.ts tests/imports/capability-contract-boundaries.test.ts tests/imports/capability-contract-registry-boundaries.test.ts tests/imports/capability-supply-boundaries.test.ts tests/imports/customer-request-boundaries.test.ts tests/imports/customer-request-source-completeness.test.ts tests/imports/kernel-retirement-manifest.test.ts tests/imports/legacy-engine-retirement.test.ts tests/imports/action-invocation-host-boundaries.test.ts tests/imports/paid-operation-development-surface-exclusion.test.ts tests/imports/product-frontier-manifest.test.ts tests/imports/development-evidence-boundary.test.ts",
    "test:imports:fixtures": "AE_SCAN_MODE=fixtures node tools/dev/run-with-cleanup.mjs vitest run tests/imports/backup-imports.test.ts tests/imports/private-imports.test.ts tests/imports/route-boundary.test.ts",
    "test:ts-standards": "AE_SCAN_MODE=clean node tools/dev/run-with-cleanup.mjs vitest run tests/imports/ts-standards.test.ts",
    "test:ts-standards:fixtures": "AE_SCAN_MODE=fixtures node tools/dev/run-with-cleanup.mjs vitest run tests/imports/ts-standards.test.ts",
    "test:seo": "node tools/dev/run-with-cleanup.mjs vitest run tests/seo",
    "test:ui-contract": "AE_SCAN_MODE=clean node tools/dev/run-with-cleanup.mjs vitest run tests/ui-contract",
    "test:all": "npm run typecheck && npm run check:convex-codegen && npm run test:unit && npm run test:integration && npm run test:types && npm run test:imports && npm run test:ts-standards && npm run test:seo && npm run test:ui-contract && npm run build",
    "doctor": "npm exec --offline -- react-doctor",
    "test:quality:gate": "node tools/dev/run-with-cleanup.mjs npx tsx eval/quality/gate.ts",
    "test:quality:gate:live": "node tools/dev/run-with-cleanup.mjs npx tsx eval/quality/gate.ts --live",
    "test:eval:braintrust:local": "node tools/dev/run-with-cleanup.mjs tsx eval/braintrust/answer.eval.ts",
    "test:eval:braintrust:remote": "node tools/dev/run-with-cleanup.mjs tsx eval/braintrust/answer.eval.ts --remote"
  },
