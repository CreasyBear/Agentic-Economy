{
  "name": "agentic-economy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "ae": "tsx tools/ae/cli.ts",
    "build:cli": "node scripts/build-cli.mjs",
    "prepack": "npm run build:cli",
    "test:cli-package": "npm run build:cli && node scripts/test-cli-package.mjs",
    "parity:check": "node eval/parity/check-parity.mjs",
    "audit:actions": "node scripts/audit-action-surfaces.mjs",
    "dev": "vite dev --host 127.0.0.1",
    "dev:local": "node tools/dev/local-dev.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src convex tests tools --deny-warnings",
    "check:convex-codegen": "convex codegen --dry-run --typecheck=disable",
    "gate:release": "npm run test:release:source",
    "test:release:unit": "node tools/dev/run-with-cleanup.mjs vitest run tests/unit --reporter=default --reporter=json --outputFile.json=output/release/unit-vitest.json",
    "test:release:integration": "node tools/dev/run-with-cleanup.mjs vitest run tests/integration convex --no-file-parallelism --test-timeout=15000 --reporter=default --reporter=json --outputFile.json=output/release/integration-vitest.json",
    "verify:deployment-manifest": "tsx tools/release/verify-deployment-manifest.ts",
    "test:conformance": "vitest run tests/unit/action-invocation/durable-action-invocation-transact.test.ts tests/unit/action-invocation/durable-action-invocation-lease.test.ts tests/unit/action-invocation/durable-action-invocation-release.test.ts tests/unit/action-invocation/durable-action-invocation-cancel.test.ts tests/unit/action-invocation/durable-action-invocation-observation.test.ts tests/unit/action-invocation/durable-action-invocation-result.test.ts tests/unit/action-invocation/dynamic-published-operation-adapter.test.ts tests/unit/action-invocation/dynamic-published-operation-paid.test.ts tests/unit/action-invocation/dynamic-published-operation-recovery.test.ts tests/unit/action-invocation/dynamic-published-operation-snapshot.test.ts tests/unit/action-invocation/paid-operation-provider-selection.test.ts tests/unit/action-invocation/x402-payment-reconciliation.test.ts tests/unit/capability-execution/operation-invoke-admit.test.ts tests/unit/capability-execution/operation-invoke-dispatch.test.ts tests/unit/capability-execution/operation-invoke-recover.test.ts tests/unit/capability-execution/operation-recovery-actions.test.ts tests/unit/convex/capability-operation-recovery.test.ts tests/unit/convex/capability-operation-worker-run.test.ts tests/unit/convex/capability-operation-worker-recover.test.ts tests/unit/convex/capability-operation-worker-charge.test.ts tests/unit/convex/capability-operation-worker-lease.test.ts tests/integration/capability-operation-workpool.test.ts tests/unit/server/operation-invoke-api.test.ts tests/unit/capability-supply/provider-connection.test.ts tests/unit/capability-supply/route-transport-mcp.test.ts tests/unit/capability-supply/route-transport-x402.test.ts tests/unit/capability-supply/route-transport-invoke.test.ts tests/unit/capability-supply/route-transport-http-json.test.ts tests/unit/capability-supply/route-transport-cancel.test.ts tests/unit/capability-supply/route-transport-observation.test.ts tests/unit/capability-supply/readiness-probe-http-json.test.ts tests/unit/capability-supply/readiness-probe-mcp.test.ts tests/unit/capability-supply/readiness-probe-x402.test.ts tests/unit/capability-supply/readiness-probe-quote.test.ts tests/unit/capability-supply/eligible-supply.test.ts tests/unit/capability-supply/publication-importers-openapi.test.ts tests/unit/capability-supply/publication-importers-mcp.test.ts tests/unit/capability-supply/publication-importers-x402.test.ts tests/unit/capability-supply/provider-approval.test.ts tests/unit/capability-supply/published-operation-provider-conformance.test.ts tests/unit/capability-supply/provider-conformance-evidence.test.ts tests/integration/capability-supply-owner-funnel-publish.test.ts tests/integration/capability-supply-owner-funnel-read.test.ts tests/integration/capability-supply-owner-funnel-run-test.test.ts tests/integration/capability-supply-owner-funnel-withdraw-republish.test.ts tests/integration/capability-supply-owner-funnel-reserve.test.ts tests/unit/deployment/deployment-manifest.test.ts tests/unit/server/diagnostic-routes.test.ts tests/unit/server/request-correlation.test.ts tests/unit/server/start-observability.test.ts",
    "test:chat:conformance": "mkdir -p output/release && node tools/dev/run-with-cleanup.mjs vitest run tests/unit/chat/convex-agent-component.test.ts tests/unit/chat/operation-chat-agent-tools.test.ts tests/unit/chat/operation-chat-execute.test.ts tests/unit/chat/anonymous-chat-boundary.test.ts tests/unit/chat/chat-share-token.test.ts tests/unit/routes/chat-anonymous.test.ts tests/integration/chat-anonymous-transport.test.ts tests/integration/chat-durable-messaging-share.test.ts tests/integration/chat-thread-metadata.test.ts tests/unit/operation-chat-ui/operation-chat.test.tsx tests/unit/capability-execution/operation-execute.test.ts tests/unit/security/ssrf-surface-drift.test.ts tests/unit/chat/operation-chat-provider-boundary.test.tsx tests/unit/routes/operation-chat-routes.test.tsx --no-file-parallelism --test-timeout=15000 --reporter=default --reporter=json --outputFile.json=output/release/chat-conformance-vitest.json",
    "seed:dev": "convex run devSeed:seedDevCatalog",
    "test:release": "npm run test:release:source",
    "test:release:source": "mkdir -p output/release && npm run verify:deployment-manifest -- --environment development && npm run test:conformance && npm run test:chat:conformance && npm run check:convex-codegen && npm run test:release:source:after-codegen",
    "test:release:source:after-codegen": "npm run lint && npm run typecheck && npm run test:release:unit && npm run test:release:integration && npm run test:types && npm run test:imports && npm run test:ts-standards && npm run test:seo && npm run test:ui-contract && npm run test:cli-package && npm run build",
    "test:release:live-gateway": "npm run smoke:gateway:production --",
    "smoke:gateway:production": "node tools/dev/run-with-cleanup.mjs tsx tools/release/operation-gateway-production-smoke.ts",
    "smoke:chat:staging": "node tools/dev/run-with-cleanup.mjs playwright test --config=playwright.chat-staging.config.ts tests/deploy-smoke/chat-anonymous-streaming-smoke.spec.ts",
    "validate:release:gateway": "tsx tools/release/validate-operation-gateway-production-smoke-receipt.ts",
    "evidence:action-invocation:development": "tsx tools/dev/action-invocation-development-evidence.ts",
    "evidence:operation:development": "tsx tools/dev/development-provider-operation-evidence.ts",
    "evidence:bounded-mandate:development": "tsx tools/dev/bounded-mandate-evidence-packet.ts",
    "evidence:full-yolo:development": "tsx tools/dev/full-yolo-evidence-packet.ts",
    "test": "node tools/dev/run-with-cleanup.mjs vitest run",
    "test:unit": "node tools/dev/run-with-cleanup.mjs vitest run tests/unit",
    "test:integration": "node tools/dev/run-with-cleanup.mjs vitest run tests/integration convex --no-file-parallelism",
    "test:eval": "npm run test:eval:coverage && npm run test:eval:report && PROMPTFOO_CONFIG_DIR=.promptfoo-home PROMPTFOO_DISABLE_WAL_MODE=true node tools/dev/run-with-cleanup.mjs promptfoo eval -c eval/answer/promptfooconfig.yaml --no-cache && node tools/dev/run-with-cleanup.mjs vitest run tests/eval",
    "test:eval:coverage": "node tools/dev/run-with-cleanup.mjs tsx eval/answer/scripts/audit-coverage.ts",
    "test:eval:report": "node tools/dev/run-with-cleanup.mjs tsx eval/answer/scripts/run-suite.ts --output output/eval/answer-suite-report.json",
    "test:eval:validate": "npm run test:eval:coverage && PROMPTFOO_CONFIG_DIR=.promptfoo-home PROMPTFOO_DISABLE_WAL_MODE=true node tools/dev/run-with-cleanup.mjs promptfoo validate -c eval/answer/promptfooconfig.yaml",
    "test:e2e": "node tools/dev/run-with-cleanup.mjs playwright test tests/e2e",
    "test:e2e:paid-operation": "node tools/dev/run-with-cleanup.mjs playwright test --config=playwright.paid-operation.config.ts tests/e2e/paid-operation-development-surface.spec.ts",
    "test:e2e:a11y": "node tools/dev/run-with-cleanup.mjs playwright test tests/e2e/a11y --workers=1",
    "test:types": "node tools/dev/run-with-cleanup.mjs vitest run tests/types",
    "test:imports": "AE_SCAN_MODE=clean node tools/dev/run-listed-vitest.mjs tests/imports/backup-imports.test.ts tests/imports/private-imports.test.ts tests/imports/route-boundary.test.ts tests/imports/capability-contract-boundaries.test.ts tests/imports/capability-contract-registry-boundaries.test.ts tests/imports/capability-supply-boundaries.test.ts tests/imports/action-invocation-host-boundaries.test.ts tests/imports/paid-operation-development-surface-exclusion.test.ts tests/imports/operation-surface-conformance.test.ts tests/imports/development-evidence-boundary.test.ts tests/imports/operation-product-legacy-independence.test.ts",
    "test:imports:fixtures": "AE_SCAN_MODE=fixtures node tools/dev/run-with-cleanup.mjs vitest run tests/imports/backup-imports.test.ts tests/imports/private-imports.test.ts tests/imports/route-boundary.test.ts",
    "test:ts-standards": "AE_SCAN_MODE=clean node tools/dev/run-with-cleanup.mjs vitest run tests/imports/ts-standards.test.ts",
    "test:ts-standards:fixtures": "AE_SCAN_MODE=fixtures node tools/dev/run-with-cleanup.mjs vitest run tests/imports/ts-standards.test.ts",
    "test:seo": "node tools/dev/run-with-cleanup.mjs vitest run tests/seo",
    "test:ui-contract": "AE_SCAN_MODE=clean node tools/dev/run-with-cleanup.mjs vitest run tests/ui-contract",
    "test:all": "npm run typecheck && npm run check:convex-codegen && npm run test:unit && npm run test:integration && npm run test:types && npm run test:imports && npm run test:ts-standards && npm run test:seo && npm run test:ui-contract && npm run build",
    "doctor": "npm exec --offline -- react-doctor",
    "test:eval:braintrust:local": "node tools/dev/run-with-cleanup.mjs tsx eval/braintrust/answer.eval.ts",
    "test:eval:braintrust:remote": "node tools/dev/run-with-cleanup.mjs tsx eval/braintrust/answer.eval.ts --remote"
  },
