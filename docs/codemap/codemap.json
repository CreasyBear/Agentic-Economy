    {
      "trigger": "POST /api/requests (or /api/v1/requests) from browser/agent",
      "steps": [
        "frontend",
        "server-adapters",
        "convex-backend",
        "customer-request",
        "capability-supply",
        "convex-backend",
        "provider-systems",
        "convex-backend"
      ],
      "outcome": "A bounded proposal is compiled to a proposal_only route generation; on exact-revision confirmation a bounded mandate is created and a durable run executes the registered transport (HTTP/MCP/x402) under network-guard, records the outcome, reconciles any payment, and projects the customer-safe next action."
    },
    {
      "trigger": "Customer query to planPreview (NL -> discover -> interpret -> compile)",
      "steps": [
        "convex-backend",
        "customer-request",
        "catalog-registry",
        "customer-request",
        "model-gateway",
        "openrouter",
        "customer-request",
        "convex-backend"
      ],
      "outcome": "Discovery narrows the routeable pool from the deployed registry; the composite interpreter (model-led with deterministic recovery) proposes; compile returns a typed preview (inspect_only), a typed needs_information ask, or an unavailable reason."
    },
    {
      "trigger": "POST /api/answer/turn",
      "steps": [
        "frontend",
        "server-adapters",
        "answer-thread",
        "harness",
        "answer",
        "model-gateway",
        "openrouter",
        "convex-backend",
        "answer-thread"
      ],
      "outcome": "The turn orchestrator runs a HarnessRunLoop; retrieval-first paths use registered read actions, model paths use the answer tool-use agent; typed stream events are emitted and the durable thread/harness journal is finalized, then served as a redacted projection."
    },
    {
      "trigger": "/ root journey (?q= or ?project=)",
      "steps": [
        "frontend",
        "server-adapters",
        "catalog-registry",
        "customer-request",
        "work-tree",
        "convex-backend",
        "frontend"
      ],
      "outcome": "A BAS ask starts a durable WorkTree and redirects; a normal ask runs public-services search + plan preview, web-discover claims are labelled, and the UI renders the WorkTree panel or service list from redacted projections."
    },
    {
      "trigger": "Curated supply admission + publication readback",
      "steps": [
        "convex-backend",
        "capability-supply",
        "capability-contract",
        "convex-backend",
        "catalog-registry",
        "discovery"
      ],
      "outcome": "Admission normalizes the provider OpenAPI/MCP schema (or refuses by name), publication carries provenance, contracts are validated/registered, the ~20-op curated catalog is seeded idempotently, and registry/operations + discovery manifests are projected."
    }
  ]
